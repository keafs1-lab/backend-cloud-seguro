# URL completa do PostgreSQL. Nunca compartilhe este arquivo com credenciais reais.
DATABASE_URL=postgres://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO

# Gere com: openssl rand -base64 48
# Use um segredo aleatório com pelo menos 32 caracteres e mantenha-o privado.
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_LONGO
JWT_EXPIRES_IN=15m

PORT=3000

# SSL é obrigatório por padrão. Só desative em um PostgreSQL local isolado.
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Origens frontend autorizadas separadas por vírgula. Exemplo:
# CORS_ORIGINS=https://meu-frontend.example.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173
